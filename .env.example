PORT=8999

# 图片生命时间（小时），默认24小时
# 超过这个时间的图片文件将被自动清理
IMAGE_LIFETIME_HOURS=24

# 图片存储后端：local（默认）、s3 或 r2（兼容 Cloudflare R2）
STORAGE_BACKEND=local

# R2 需要 endpoint；标准 AWS S3 可省略并使用 boto3 默认配置
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=astrbot-t2i
# 凭证可省略，届时 boto3 会使用 IAM Role、配置文件等默认凭证链
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# S3_PREFIX=images
