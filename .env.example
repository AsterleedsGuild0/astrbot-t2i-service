PORT=8999

# Image lifetime in hours. Files older than this are removed automatically.
IMAGE_LIFETIME_HOURS=24

# Image storage backend: local (default), s3, or r2 (Cloudflare R2 compatible).
STORAGE_BACKEND=local

# R2 requires an endpoint URL. Standard AWS S3 can use boto3 defaults.
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=astrbot-t2i
# Credentials are optional when using an IAM role or another boto3 provider.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# S3_PREFIX=images

# Prometheus metrics are disabled by default. Set true to expose GET /metrics.
METRICS_ENABLED=false
# Set a strong random token in production; scrapers must send it as a bearer token.
# METRICS_TOKEN=

# Playwright 页面导航等待状态，默认 domcontentloaded。
# 可选值：commit / domcontentloaded / load / networkidle
T2I_RENDER_WAIT_UNTIL=domcontentloaded

# 是否跳过 Playwright 截图前的 document.fonts.ready 等待。
# 在远程字体加载缓慢或不可达时可显著降低截图超时概率。
T2I_SKIP_FONT_READY=true

# In-process rate limiting. 0 disables the limiter.
RATE_LIMIT_MAX_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=0
